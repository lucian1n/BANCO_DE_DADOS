1. Esquema do Banco de Dados (PostgreSQL)

-- Criação do banco (execute no terminal normal: sudo -u postgres psql)
CREATE DATABASE companhia_aerea;
\c companhia_aerea;

-- Tabela AEROPORTO
CREATE TABLE AEROPORTO (
    id_aeroporto SERIAL PRIMARY KEY,
    nome_aeroporto VARCHAR(100) NOT NULL,
    sigla CHAR(3) UNIQUE NOT NULL,
    cidade VARCHAR(100) NOT NULL,
    uf CHAR(2) NOT NULL,
    pais VARCHAR(50) NOT NULL
);

-- Tabela AERONAVE
CREATE TABLE AERONAVE (
    id_aeronave SERIAL PRIMARY KEY,
    modelo VARCHAR(50) NOT NULL,
    fabricante VARCHAR(50) NOT NULL,
    capacidade INT NOT NULL
);

-- Tabela VOO
CREATE TABLE VOO (
    id_voo SERIAL PRIMARY KEY,
    codigo_voo VARCHAR(10) UNIQUE NOT NULL,
    horario_previsto_saida TIMESTAMP NOT NULL,
    horario_previsto_chegada TIMESTAMP NOT NULL,
    horario_real_saida TIMESTAMP,
    horario_real_chegada TIMESTAMP,
    status_voo VARCHAR(20) CHECK (status_voo IN ('EMBARQUE', 'EM_CURSO', 'ATRASADO', 'POUSADO', 'CANCELADO')),
    portao_embarque VARCHAR(10),
    terminal VARCHAR(10),
    id_aeronave INT REFERENCES AERONAVE(id_aeronave),
    id_aeroporto_origem INT REFERENCES AEROPORTO(id_aeroporto),
    id_aeroporto_destino INT REFERENCES AEROPORTO(id_aeroporto)
);

-- Tabela POSICAO_VOO
CREATE TABLE POSICAO_VOO (
    id_posicao SERIAL PRIMARY KEY,
    data_hora_posicao TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    latitude DECIMAL(10, 8),
    longitude DECIMAL(11, 8),
    altitude INT,
    velocidade INT,
    percentual_trajeto DECIMAL(5, 2),
    previsao_chegada_atualizada TIMESTAMP,
    id_voo INT REFERENCES VOO(id_voo)
);


