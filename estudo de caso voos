import redis

redis_client = redis.Redis(host='localhost', port=6379, db=0, decode_responses=True)

def exibir_painel_site():
    print("=== PAINEL DE VOOS EM CURSO (SITE) ===")
    
    ids_voos = redis_client.lrange('lista_voos_em_curso', 0, -1)
    
    if not ids_voos:
        print("Nenhum voo em curso no momento.")
        return

    for id_voo in ids_voos:
        dados = redis_client.hgetall(f'voo_info:{id_voo}')
        print(f"Voo: {dados.get('codigo_voo')} | Rota: {dados.get('origem')} -> {dados.get('destino')} | "
              f"Trajeto: {dados.get('percentual_trajeto')} | Chegada Est.: {dados.get('previsao_chegada')}")

if __name__ == "__main__":
    exibir_painel_site()
