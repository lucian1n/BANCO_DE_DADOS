3. As 4 Consultas Principais (PostgreSQL)

-- 1. Obter todos os dados de um voo
SELECT v.*, a.modelo, o.sigla AS origem, d.sigla AS destino
FROM VOO v
JOIN AERONAVE a ON v.id_aeronave = a.id_aeronave
JOIN AEROPORTO o ON v.id_aeroporto_origem = o.id_aeroporto
JOIN AEROPORTO d ON v.id_aeroporto_destino = d.id_aeroporto
WHERE v.id_voo = 1;

-- 2. Obter os dados de posição de um voo
SELECT * FROM POSICAO_VOO WHERE id_voo = 1 ORDER BY data_hora_posicao DESC;

-- 3. Obter uma lista dos voos em atraso
SELECT codigo_voo, horario_previsto_saida FROM VOO WHERE status_voo = 'ATRASADO';

-- 4. Obter uma lista dos voos cancelados
SELECT codigo_voo, origem.sigla AS origem, destino.sigla AS destino 
FROM VOO 
JOIN AEROPORTO origem ON VOO.id_aeroporto_origem = origem.id_aeroporto
JOIN AEROPORTO destino ON VOO.id_aeroporto_destino = destino.id_aeroporto
WHERE status_voo = 'CANCELADO';


4. Integração Python: PostgreSQL -> Redis

import psycopg2
import psycopg2.extras
import redis

# Conexão com os bancos
pg_conn = psycopg2.connect(
    dbname="companhia_aerea",
    user="postgres",
    password="unochapeco",
    host="localhost"
)
redis_client = redis.Redis(host='localhost', port=6379, db=0, decode_responses=True)

def atualizar_cache():
    cursor = pg_conn.cursor(cursor_factory=psycopg2.extras.DictCursor)
    
    # Busca voos 'EM_CURSO'
    query = """
        SELECT v.id_voo, v.codigo_voo, o.sigla AS origem, d.sigla AS destino, 
               v.horario_previsto_chegada, p.percentual_trajeto, p.previsao_chegada_atualizada
        FROM VOO v
        JOIN AEROPORTO o ON v.id_aeroporto_origem = o.id_aeroporto
        JOIN AEROPORTO d ON v.id_aeroporto_destino = d.id_aeroporto
        LEFT JOIN LATERAL (
            SELECT percentual_trajeto, previsao_chegada_atualizada 
            FROM POSICAO_VOO 
            WHERE id_voo = v.id_voo 
            ORDER BY data_hora_posicao DESC LIMIT 1
        ) p ON true
        WHERE v.status_voo = 'EM_CURSO';
    """
    cursor.execute(query)
    voos_em_curso = cursor.fetchall()
    
    # Atualiza o Redis (Lista e Hashes)
    redis_client.delete('lista_voos_em_curso')
    for voo in voos_em_curso:
        id_voo = str(voo['id_voo'])
        redis_client.rpush('lista_voos_em_curso', id_voo)
        
        dados_voo = {
            'codigo_voo': voo['codigo_voo'],
            'origem': voo['origem'],
            'destino': voo['destino'],
            'previsao_chegada': str(voo['previsao_chegada_atualizada'] or voo['horario_previsto_chegada']),
            'percentual_trajeto': str(voo['percentual_trajeto'] or 0) + '%'
        }
        redis_client.hset(f'voo_info:{id_voo}', mapping=dados_voo)
        
    print(f"Cache atualizado com sucesso! {len(voos_em_curso)} voos em curso sincronizados.")
    cursor.close()

if __name__ == "__main__":
    atualizar_cache()



